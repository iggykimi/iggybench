# Qwen3.8-27B · dense 27B · FP8 · with the vision encoder (T11, T11D). Results go to the qwen27b-fp8 tag.
TAG=qwen27b-fp8
PORT=8000
MODEL=qwen38-27b-fp8
HF_REPO=Qwen/Qwen3.8-27B-FP8
MODEL_DIR=$MODELS_DIR/qwen38-27b-fp8
ENGINE=vllm
IMG=vllm/vllm-openai:v0.32.0
SERVE_ARGS=(--tensor-parallel-size 1 --max-num-batched-tokens 16384 --kv-cache-dtype fp8
            --enable-prefix-caching --enable-prompt-tokens-details
            --reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder
            --gpu-memory-utilization 0.85 --max-model-len 262144 --max-num-seqs 256 --mamba-ssm-cache-dtype bfloat16)
