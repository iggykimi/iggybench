# Liquid d1-3B · 3.1B decision model (and Laya, loaded from the HF cache) vs gpt-oss-120b on e-mail triage.
# Runs in-process with Transformers inside the vLLM image. Start gptoss120b-shared.env first (port 8000).
# HARD=1 runs the hard e-mail set. Needs the Laya source and weights (download_models.sh).
TAG=d1-3b
PORT=8000
HF_REPO=LiquidAI/d1-3B
MODEL_DIR=$MODELS_DIR/d1-3b
ENGINE=transformers
IMG=vllm/vllm-openai:v0.32.0
[ "${HARD:-0}" = 1 ] && TAG=d1-3b-dificil
client() {
  # shellcheck disable=SC2046
  timeout 2400 $DOCKER run --rm --gpus all --ipc=host --network host \
      -v "$MODEL_DIR:/model/d1:ro" -v "$PYLIB_DIR:/pylib:ro" -v "$BENCH:/bench:ro" -v "$1:/out" \
      -v "$HF_CACHE:/root/.cache/huggingface" \
      --entrypoint python3 "$IMG" /bench/email_classify.py /model/d1 /out http://127.0.0.1:8000 gpt-oss-120b \
      $([ "${HARD:-0}" = 1 ] && echo dificil)
}
