# DeepSeek V4 Flash 0731 · MoE 284B total / 13B active, sparse attention · FP8
# 256 sequences and CUDA graphs up to 256 (default 128).
TAG=dsv4-flash-s256
PORT=8000
MODEL=dsv4-flash
HF_REPO=                  # repo id not recorded
MODEL_DIR=$MODELS_DIR/deepseek-v4-flash-0731
ENGINE=vllm
IMG=vllm/vllm-openai:v0.32.0
TIMEOUT=7200
DOCKER_ARGS=(-e VLLM_ENGINE_READY_TIMEOUT_S=7200)
SERVE_ARGS=(--tensor-parallel-size 1 --trust-remote-code --kv-cache-dtype fp8 --block-size 256
            --tokenizer-mode deepseek_v4 --tool-call-parser deepseek_v4 --reasoning-parser deepseek_v4
            --enable-auto-tool-choice --enable-prefix-caching --enable-prompt-tokens-details --max-num-seqs 256
            --attention_config.indexer_kv_dtype fp8 --max-cudagraph-capture-size 256
            --compilation-config '{"cudagraph_mode":"FULL_AND_PIECEWISE","custom_ops":["all"]}'
            --gpu-memory-utilization 0.88 --max-num-batched-tokens 8192 --max-model-len 262144)
TOKMODE=deepseek_v4
