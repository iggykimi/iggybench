# Qwen3.8-27B · dense 27B (hybrid Gated DeltaNet + attention) · NVFP4
# First smoke run (T1 T2) on a pre-release vLLM build; the image tag is the one recorded in suite_info.txt.
TAG=qwen27b-nvfp4-v028
PORT=8000
MODEL=qwen38-27b
HF_REPO=                  # repo id not recorded
MODEL_DIR=$MODELS_DIR/qwen38-27b-nvfp4
ENGINE=vllm
IMG=vllm/vllm-openai:glm53-flash-arm64-cu130
SERVE_ARGS=(--tensor-parallel-size 1 --gpu-memory-utilization 0.85 --max-model-len 262144
            --max-num-seqs 256 --max-num-batched-tokens 16384 --kv-cache-dtype fp8 --enable-prefix-caching
            --reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder --skip-mm-profiling)
