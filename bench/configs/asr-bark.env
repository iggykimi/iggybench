# Underdog Bark 3.0 Pro · 0.6B Parakeet TDT fine-tune (English) · not served by vLLM: run in-process with
# Transformers inside the audio image (installed on the fly if ParakeetForTDT is missing). Same clips and WER as asr.py.
TAG=asr
PORT=8000
HF_REPO=ConwayResearch/Underdog-Bark-3.0-Pro
MODEL_DIR=$MODELS_DIR/asr-bark-pro
ENGINE=transformers
IMG=iggybench/vllm-audio:0.32.0
HF_INCLUDE=("*.json" "*.safetensors" "NOTICE")
BUILD=$BENCH/docker/vllm-audio
client() {
  timeout 1200 $DOCKER run --rm --gpus all --ipc=host -v "$MODEL_DIR:/model:ro" -v "$DATASETS_DIR/asr:/asr:ro" \
      -v "$BENCH:/bench:ro" -v "$1:/out" --entrypoint bash "$IMG" -c \
      'python3 -c "from transformers import ParakeetForTDT" 2>/dev/null \
       || python3 -m pip install -q -U transformers soxr || uv pip install --system -U transformers soxr
       python3 -c "import transformers; print(\"transformers\", transformers.__version__)"
       python3 /bench/asr_transformers.py /model /asr /out/asr_bark.json'
}
