# Qwen3.8-Flash-Next · MoE 125B total / 6B active + 51B n-gram table + MTP · FP8
# n-gram table in GPU memory
TAG=qwen38-flash-next-ngramgpu
PORT=8000
MODEL=qwen38-flash-next
HF_REPO=                  # repo id not recorded
MODEL_DIR=$MODELS_DIR/qwen38-flash-next-fp8
ENGINE=vllm
IMG=vllm/vllm-openai:v0.32.0
TIMEOUT=7200
DOCKER_ARGS=(-e VLLM_ENGINE_READY_TIMEOUT_S=7200)
SERVE_ARGS=(--tensor-parallel-size 1 --kv-cache-dtype fp8 --enable-prefix-caching --enable-prompt-tokens-details
            --gpu-memory-utilization 0.88 --max-num-seqs 256 --max-num-batched-tokens 8192
            --enable-auto-tool-choice --tool-call-parser qwen3_coder --reasoning-parser qwen3
            --speculative-config '{"method":"mtp","num_speculative_tokens":3}'
            --attention-config.indexer_kv_dtype fp8 --mamba-ssm-cache-dtype bfloat16 --engram-config '{"cpu_offload":false}')
