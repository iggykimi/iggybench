# IBM Granite 4.0 1B Speech · 1B · speech-to-text on 420 FLEURS clips (7 languages). Args from the orchestration script (no server_cmd.txt was recorded for this workload).
TAG=asr
PORT=8000
MODEL=granite-4.0-1b-speech
HF_REPO=ibm-granite/granite-4.0-1b-speech
MODEL_DIR=$MODELS_DIR/asr-granite-4.0-1b-speech
ENGINE=vllm
IMG=iggybench/vllm-audio:0.32.0
TIMEOUT=900
SERVE_ARGS=(--gpu-memory-utilization 0.30 --max-num-seqs 64 --trust-remote-code)
BUILD=$BENCH/docker/vllm-audio
NOGEN=1
client() { timeout 900 python3 "$BENCH/asr.py" "$BASE" "$MODEL" "$1/asr_$MODEL.json" "$DATASETS_DIR/asr" --conc 1,32; }
