# NVIDIA Nemotron 3.5 Super VL · MoE 120B total / 12B active, Mamba-2 + MoE + attention, vision · NVFP4 · MTP 3
TAG=nemotron35-super-vl
PORT=8000
MODEL=nemotron35-super-vl
HF_REPO=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4
MODEL_DIR=$MODELS_DIR/nemotron35-super-vl-nvfp4
ENGINE=vllm
IMG=vllm/vllm-openai:v0.32.0
TIMEOUT=2400
SERVE_ARGS=(--trust-remote-code --enable-prompt-tokens-details --gpu-memory-utilization 0.85
            --max-model-len 131072 --max-num-seqs 256 --max-num-batched-tokens 16384 --mamba-ssm-cache-dtype float32
            --enable-auto-tool-choice --tool-call-parser qwen3_coder --reasoning-parser nemotron_v3
            --speculative-config '{"method":"mtp","num_speculative_tokens":3}')
