# PaddleOCR-VL-1.6 · 0.9B OCR VLM. OCR -> gpt-oss pipeline on the invoices. Args from the orchestration script (no server_cmd.txt was recorded for this workload).
# Start gptoss120b-shared.env first (port 8000). DEGRADED=1 runs the degraded invoice set.
TAG=paddleocr+gptoss
PORT=8001
MODEL=paddleocr-vl-1.6
HF_REPO=PaddlePaddle/PaddleOCR-VL-1.6
MODEL_DIR=$MODELS_DIR/paddleocr-vl-1.6
ENGINE=vllm
IMG=vllm/vllm-openai:v0.32.0
SERVE_ARGS=(--trust-remote-code --max-num-batched-tokens 16384 --no-enable-prefix-caching --mm-processor-cache-gb 0
            --gpu-memory-utilization 0.20 --max-num-seqs 128)
[ "${DEGRADED:-0}" = 1 ] && TAG=paddleocr+gptoss-dificil
client() {
  if [ "${DEGRADED:-0}" = 1 ]; then
    timeout 2400 python3 "$BENCH/invoices_ocr.py" "$BASE" "$MODEL" http://127.0.0.1:8000 gpt-oss-120b "$1" \
        --docs "$BENCH/data/invoices_degraded" --conc 1,8,32 --conc-tuberia 1,16
  else
    timeout 3600 python3 "$BENCH/invoices_ocr.py" "$BASE" "$MODEL" http://127.0.0.1:8000 gpt-oss-120b "$1" \
        --docs "$BENCH/data/invoices_clean"
  fi
}
