# Qwen3-ASR 1.7B · speech-to-text on 420 FLEURS clips (7 languages). Args from the orchestration script (no server_cmd.txt was recorded for this workload).
TAG=asr
PORT=8000
MODEL=qwen3-asr-1.7b
HF_REPO=Qwen/Qwen3-ASR-1.7B
MODEL_DIR=$MODELS_DIR/asr-qwen3-asr
ENGINE=vllm
IMG=iggybench/vllm-audio:0.32.0
TIMEOUT=900
SERVE_ARGS=(--gpu-memory-utilization 0.30 --max-num-seqs 64 --trust-remote-code)
BUILD=$BENCH/docker/vllm-audio
NOGEN=1
client() { timeout 900 python3 "$BENCH/asr.py" "$BASE" "$MODEL" "$1/asr_$MODEL.json" "$DATASETS_DIR/asr" --conc 1,32; }
