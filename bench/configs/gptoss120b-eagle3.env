# gpt-oss-120b · MoE 117B total / 5.1B active · MXFP4
# EAGLE-3 speculative-decoding draft (3 tokens)
TAG=gptoss120b-eagle3
PORT=8000
MODEL=gpt-oss-120b
HF_REPO=openai/gpt-oss-120b   # public release; the download itself was not logged
MODEL_DIR=$MODELS_DIR/gpt-oss-120b
ENGINE=vllm
IMG=vllm/vllm-openai:v0.32.0
TIMEOUT=2400
SERVE_ARGS=(--tensor-parallel-size 1 --enable-prefix-caching --enable-prompt-tokens-details
            --max-model-len 131072 --max-num-seqs 256 --max-num-batched-tokens 16384
            --tool-call-parser openai --enable-auto-tool-choice --reasoning-parser openai_gptoss --gpu-memory-utilization 0.85
            --speculative-config '{"method":"eagle3","model":"/draft","num_speculative_tokens":3}')
DRAFT_REPO=nvidia/gpt-oss-120b-Eagle3
DRAFT_DIR=$MODELS_DIR/gpt-oss-120b-eagle3
