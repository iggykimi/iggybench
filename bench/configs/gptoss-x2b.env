# gpt-oss-120b · MoE 117B total / 5.1B active · MXFP4
# One of two copies at 42 % of the GPU each, run together (see configs/README.md)
TAG=gptoss-x2b
PORT=8001
MODEL=gpt-oss-120b
HF_REPO=openai/gpt-oss-120b   # public release; the download itself was not logged
MODEL_DIR=$MODELS_DIR/gpt-oss-120b
ENGINE=vllm
IMG=vllm/vllm-openai:v0.32.0
TIMEOUT=2400
SERVE_ARGS=(--tensor-parallel-size 1 --enable-prefix-caching --enable-prompt-tokens-details
            --max-model-len 131072 --max-num-seqs 256 --max-num-batched-tokens 16384
            --tool-call-parser openai --enable-auto-tool-choice --reasoning-parser openai_gptoss --gpu-memory-utilization 0.42)
