# GLM-5.3-Flash · MoE 320B total / 18B active, hybrid KDA linear attention + sparse attention · NVFP4
# First run of batch 1, with the fallback reasoning parser glm45.
TAG=glm53-sinmtp
PORT=8000
MODEL=glm53-flash
HF_REPO=                  # repo id not recorded
MODEL_DIR=$MODELS_DIR/glm53-nvfp4
ENGINE=vllm
IMG=vllm/vllm-openai:v0.32.0
TIMEOUT=3600
DOCKER_ARGS=(-e VLLM_ENGINE_READY_TIMEOUT_S=3600)
SERVE_ARGS=(--tensor-parallel-size 1 --kv-cache-dtype fp8 --enable-chunked-prefill
            --enable-prefix-caching --enable-prompt-tokens-details
            --reasoning-parser glm45 --tool-call-parser glm47 --enable-auto-tool-choice
            --model-loader-extra-config '{"enable_multithread_load": true, "num_threads": 64}'
            --gpu-memory-utilization 0.88 --max-model-len 262144 --max-num-seqs 256 --max-num-batched-tokens 16384)
