# OpenAI Whisper large-v3 · 1.55B · speech-to-text on 420 FLEURS clips (7 languages). Args from the orchestration script (no server_cmd.txt was recorded for this workload).
TAG=asr
PORT=8000
MODEL=whisper-large-v3
HF_REPO=openai/whisper-large-v3
MODEL_DIR=$MODELS_DIR/asr-whisper-large-v3
ENGINE=vllm
IMG=iggybench/vllm-audio:0.32.0
TIMEOUT=900
SERVE_ARGS=(--gpu-memory-utilization 0.30 --max-num-seqs 64 --trust-remote-code)
HF_INCLUDE=("*.json" "*.safetensors" "*.txt" "*.model" "*.tiktoken")
BUILD=$BENCH/docker/vllm-audio
NOGEN=1
client() { timeout 900 python3 "$BENCH/asr.py" "$BASE" "$MODEL" "$1/asr_$MODEL.json" "$DATASETS_DIR/asr" --conc 1,32; }
