# Recursive Flint · MoE 40B total / 2.5B active · BF16 · served with SGLang (vLLM 0.32 does not know the architecture)
# The image is built from the sglang/ kit in the model repository (base lmsysorg/sglang@sha256:7b6a35df9839...)
# and the server is started by that kit's serve_b300.sh. Effective settings logged by SGLang: context 262144,
# mem_fraction_static 0.8, chunked_prefill_size 4096, page_size 128, attention backend fa4, parsers flint.
TAG=flint-sglang
PORT=8000
MODEL=flint
HF_REPO=RecursiveSI/flint
MODEL_DIR=$MODELS_DIR/flint
ENGINE=sglang
IMG=flint-sglang
BUILD=$MODEL_DIR/sglang
SERVE_CMD=(bash /model/sglang/serve_b300.sh)
