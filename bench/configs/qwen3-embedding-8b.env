# Qwen3-Embedding-8B · embeddings for RAG (indexing, queries, retrieval quality). Args from the orchestration script (no server_cmd.txt was recorded for this workload).
# Start qwen3-reranker-8b.env first (port 8001) for the reranking part.
TAG=qwen3-embedding-8b
PORT=8000
MODEL=qwen3-embedding-8b
HF_REPO=Qwen/Qwen3-Embedding-8B
MODEL_DIR=$MODELS_DIR/qwen3-embedding-8b
ENGINE=vllm
IMG=vllm/vllm-openai:v0.32.0
SERVE_ARGS=(--gpu-memory-utilization 0.35 --max-model-len 8192 --max-num-batched-tokens 32768
            --runner pooling --convert embed)
NOGEN=1                   # no text generation check
client() {
  local rurl=- rmod=-
  curl -sf --max-time 5 http://127.0.0.1:8001/v1/models >/dev/null && { rurl=http://127.0.0.1:8001; rmod=qwen3-reranker-8b; }
  timeout 2400 python3 "$BENCH/rag.py" "$BASE" "$MODEL" "$rurl" "$rmod" "$1/embed.json" \
      "$DATASETS_DIR/sharegpt/ShareGPT_V3_unfiltered_cleaned_split.json" "$DATASETS_DIR/gsm8k_test.jsonl"
}
