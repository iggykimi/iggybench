# Qwen-Image · 20B text-to-image diffusion model, run in-process with diffusers (source tree in $PYLIB_DIR)
# inside the vLLM image. 1024x1024, batches 1/4/8, 50 and 25 steps.
TAG=qwen-image
PORT=8000
HF_REPO=Qwen/Qwen-Image
MODEL_DIR=$MODELS_DIR/qwen-image
ENGINE=transformers
IMG=vllm/vllm-openai:v0.32.0
client() {
  timeout 2700 $DOCKER run --rm --gpus all --ipc=host \
      -v "$MODEL_DIR:/model/img:ro" -v "$PYLIB_DIR:/pylib:ro" -v "$BENCH:/bench:ro" -v "$1:/out" \
      --entrypoint python3 "$IMG" /bench/image_gen.py /model/img /out
}
