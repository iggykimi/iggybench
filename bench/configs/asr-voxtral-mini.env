# Mistral Voxtral Mini 3B · speech-to-text on 420 FLEURS clips (7 languages). Args from the orchestration script (no server_cmd.txt was recorded for this workload).
TAG=asr
PORT=8000
MODEL=voxtral-mini-3b
HF_REPO=mistralai/Voxtral-Mini-3B-2507
MODEL_DIR=$MODELS_DIR/asr-voxtral-mini
ENGINE=vllm
IMG=iggybench/vllm-audio:0.32.0
TIMEOUT=900
SERVE_ARGS=(--gpu-memory-utilization 0.30 --max-num-seqs 64 --trust-remote-code
            --tokenizer-mode mistral --config-format mistral --load-format mistral)
BUILD=$BENCH/docker/vllm-audio
NOGEN=1
client() { timeout 900 python3 "$BENCH/asr.py" "$BASE" "$MODEL" "$1/asr_$MODEL.json" "$DATASETS_DIR/asr" --conc 1,32; }
