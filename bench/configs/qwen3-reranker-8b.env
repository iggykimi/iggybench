# Qwen3-Reranker-8B · reranker served next to qwen3-embedding-8b.env. Args from the orchestration script (no server_cmd.txt was recorded for this workload).
TAG=qwen3-reranker-8b
PORT=8001
MODEL=qwen3-reranker-8b
HF_REPO=Qwen/Qwen3-Reranker-8B
MODEL_DIR=$MODELS_DIR/qwen3-reranker-8b
ENGINE=vllm
IMG=vllm/vllm-openai:v0.32.0
SERVE_ARGS=(--runner pooling
            --hf-overrides '{"architectures":["Qwen3ForSequenceClassification"],"classifier_from_token":["no","yes"],"is_original_qwen3_reranker":true}'
            --gpu-memory-utilization 0.35 --max-model-len 8192 --max-num-batched-tokens 32768)
NOGEN=1
