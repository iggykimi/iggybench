# gpt-oss-120b · MoE 117B total / 5.1B active · MXFP4
# 55 % of the GPU: the LLM side of the OCR pipeline and the e-mail baseline (paddleocr-vl.env, d1-3b.env).
# No suite results of its own; args from the orchestration script (no server_cmd.txt was recorded).
TAG=gptoss120b-shared
PORT=8000
MODEL=gpt-oss-120b
HF_REPO=openai/gpt-oss-120b   # public release; the download itself was not logged
MODEL_DIR=$MODELS_DIR/gpt-oss-120b
ENGINE=vllm
IMG=vllm/vllm-openai:v0.32.0
TIMEOUT=2400
SERVE_ARGS=(--tensor-parallel-size 1 --enable-prefix-caching --enable-prompt-tokens-details
            --max-model-len 131072 --max-num-seqs 256 --max-num-batched-tokens 16384
            --tool-call-parser openai --enable-auto-tool-choice --reasoning-parser openai_gptoss --gpu-memory-utilization 0.55)
