# DeepSeek V4 Flash 0731 · MoE 284B total / 13B active, sparse attention · FP8
# 88 % memory and 8192-token prefill chunks (the first attempt at 92 % / 16384 crashed at 128k in T2).
# AIME at 64k tokens: T20_MAXTOK=65536 T20_SUFFIX=_64k T20_AIME_ONLY=1
TAG=dsv4-flash
PORT=8000
MODEL=dsv4-flash
HF_REPO=                  # repo id not recorded
MODEL_DIR=$MODELS_DIR/deepseek-v4-flash-0731
ENGINE=vllm
IMG=vllm/vllm-openai:v0.32.0
TIMEOUT=7200
DOCKER_ARGS=(-e VLLM_ENGINE_READY_TIMEOUT_S=7200)
SERVE_ARGS=(--tensor-parallel-size 1 --trust-remote-code --kv-cache-dtype fp8 --block-size 256
            --tokenizer-mode deepseek_v4 --tool-call-parser deepseek_v4 --reasoning-parser deepseek_v4
            --enable-auto-tool-choice --enable-prefix-caching --enable-prompt-tokens-details --max-num-seqs 128
            --attention_config.indexer_kv_dtype fp8 --max-cudagraph-capture-size 128
            --compilation-config '{"cudagraph_mode":"FULL_AND_PIECEWISE","custom_ops":["all"]}'
            --gpu-memory-utilization 0.88 --max-num-batched-tokens 8192 --max-model-len 1048576)
TOKMODE=deepseek_v4             # tokenizer mode for the benchmark client
