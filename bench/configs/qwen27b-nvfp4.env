# Qwen3.8-27B · dense 27B (hybrid Gated DeltaNet + attention) · NVFP4
# T8 offload run:  SERVE_EXTRA='--kv-offloading-size 150 --kv-offloading-backend native' T8_LABEL=offload T8_PREFIXES=220
# T6 (MTP) run:    SERVE_EXTRA='--speculative-config {"method":"mtp","num_speculative_tokens":3}'
TAG=qwen27b-nvfp4
PORT=8000
MODEL=qwen38-27b
HF_REPO=                  # repo id not recorded
MODEL_DIR=$MODELS_DIR/qwen38-27b-nvfp4
ENGINE=vllm
IMG=vllm/vllm-openai:v0.32.0
SERVE_ARGS=(--tensor-parallel-size 1 --max-num-batched-tokens 16384 --kv-cache-dtype fp8
            --enable-prefix-caching --enable-prompt-tokens-details
            --reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder --skip-mm-profiling
            --gpu-memory-utilization 0.85 --max-model-len 262144 --max-num-seqs 256)
